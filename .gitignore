# 운영체제 임시 파일
.DS_Store
Thumbs.db
desktop.ini

# 편집기 설정
.vscode/
.idea/

# Node.js
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/

# 비밀키·환경변수 — 절대 올리지 않기
.env
.env.*
*.key
*.pem

# 임시·백업 파일
*.tmp
*.bak
~$*

# ── 오락 숏폼 스튜디오 (B) ────────────────────────────────
# 실행 중 만들어지는 것은 저장소에 올리지 않습니다.
orak-shortform-studio/**/credentials.dat
orak-shortform-studio/**/*.db
orak-shortform-studio/**/*.sqlite3
orak-shortform-studio/Logs/
orak-shortform-studio/_시험출력/
orak-shortform-studio/.venv/

# 마스터 이미지 — 저장소를 비공개로 바꾼 뒤에 아래 두 줄을 지우세요.
# 지금은 공개(public) 상태라 실수로 올라가는 것을 막아두었습니다.
# 자세한 순서: orak-shortform-studio/assets/master/여기에_넣어주세요.txt
orak-shortform-studio/assets/master/*.png
orak-shortform-studio/assets/master/*.jpg

# 배포 만들기 (Stage 11) — 만들 때 나오는 것들. 저장소에 넣지 않습니다.
orak-shortform-studio/ffmpeg/
orak-shortform-studio/build/
orak-shortform-studio/dist/
orak-shortform-studio/설치파일_출력/

# 폰트·BGM은 각자 받아서 넣습니다 (라이선스·용량)
orak-shortform-studio/assets/fonts/*.ttf
orak-shortform-studio/assets/fonts/*.otf
orak-shortform-studio/assets/bgm/*.mp3
orak-shortform-studio/assets/bgm/*.m4a

# ── 보관함 (_보관/) ────────────────────────────────────────
# 위 규칙은 전부 「orak-shortform-studio/」 로 시작해서 **경로에 묶여
# 있습니다.** 폴더를 옮기면 규칙이 안 먹고, 빌드 찌꺼기(dist 360개 ·
# ffmpeg.exe 78MB)가 딸려 들어옵니다.
# 브랜치를 오가다 남는 찌꺼기 폴더. 저장소에 담지 않습니다.
_보관/_찌꺼기_*/
_보관/**/dist/
_보관/**/build/
_보관/**/ffmpeg/
_보관/**/.venv/
_보관/**/__pycache__/
_보관/**/credentials.dat
_보관/**/*.db
_보관/**/*.sqlite3
_보관/**/assets/master/*.png
_보관/**/assets/master/*.jpg
_보관/**/assets/fonts/*.ttf
_보관/**/assets/fonts/*.otf
_보관/**/assets/bgm/*.mp3
_보관/**/assets/bgm/*.m4a

# 어느 자리에 있든 막습니다 (경로에 안 묶이게)
**/dist/
**/build/
