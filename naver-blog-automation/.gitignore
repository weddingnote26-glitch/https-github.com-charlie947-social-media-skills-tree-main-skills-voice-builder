# ─────────────────────────────────────────────────────────────
# 절대 동기화하면 안 되는 것 (로그인 정보·개인 설정)
# ─────────────────────────────────────────────────────────────
private/
private/browser-profile/
!private/browser-profile/.gitkeep
*.cookie
*.cookies
cookies.json
storage_state.json

# 개인 설정 파일 (settings.example.yaml 만 동기화)
config/settings.yaml
config/settings.local.yaml

# 자동 갱신 잠금 파일
.update-sources.lock

# API 키·환경변수
.env
.env.*
!.env.example
*.key
*.pem
secrets.yaml

# ─────────────────────────────────────────────────────────────
# 로그·캐시·대용량 생성물
# ─────────────────────────────────────────────────────────────
logs/
!logs/.gitkeep
data/source_cache/
!data/source_cache/.gitkeep
*.log

# 수집한 원본 HTML (용량이 큽니다. 분석용 .md 만 동기화합니다)
samples/**/_raw/

# 원고 폴더 안의 대용량 파일
output/**/*.zip
output/**/*.mp4
output/**/*.psd
output/**/*.ai

# ─────────────────────────────────────────────────────────────
# 개발 환경
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
.venv*/
venv/
env/
node_modules/
.pytest_cache/
.mypy_cache/

# ─────────────────────────────────────────────────────────────
# 운영체제·편집기
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.tmp
*.bak
~$*

# ─────────────────────────────────────────────────────────────
# 클라우드 동기화 충돌 파일 (OneDrive / Google Drive 사용 시)
# ─────────────────────────────────────────────────────────────
*-충돌본*
*conflicted copy*
*충돌이 발생한 사본*

# ─────────────────────────────────────────────────────────────
# 실행파일 빌드 결과 (용량이 큽니다. 필요하면 다시 만들면 됩니다)
# ─────────────────────────────────────────────────────────────
build/
dist/
*.spec.bak
