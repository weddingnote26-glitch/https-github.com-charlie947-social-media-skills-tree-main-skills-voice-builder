# ═══════════════════════════════════════════════════════════════
#  선택 사항입니다. 이 파일이 없어도 8개 항목이 모두 조회됩니다.
#
#  쓰는 법
#    1. 이 파일을 복사해 .env 로 이름을 바꿉니다.
#    2. 필요한 줄의 값만 채웁니다.
#
#  ⚠ .env 는 .gitignore 에 있어 깃허브에 올라가지 않습니다.
#     키를 sources.md 나 다른 문서에 적지 마세요.
# ═══════════════════════════════════════════════════════════════

# 기본 출처(CoinGecko)가 막혔을 때만 쓰는 대체 경로입니다.
# https://coinmarketcap.com/api/ 에서 무료 키를 받을 수 있습니다.
COINMARKETCAP_API_KEY=

# 원고를 Claude API 로 자동 생성할 때만 필요합니다.
# config/settings.yaml 의 generation.mode 가 api 일 때만 씁니다.
ANTHROPIC_API_KEY=
