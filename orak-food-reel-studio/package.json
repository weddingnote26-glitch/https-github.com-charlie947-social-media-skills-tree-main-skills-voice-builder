{
  "name": "orak-food-reel-studio",
  "version": "1.0.0",
  "private": true,
  "description": "오락푸드 AI릴스 자동제작 스튜디오",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "character": "node scripts/make-character.mjs",
    "fresh": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build",
    "ffmpeg": "node scripts/fix-ffmpeg.mjs",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:dev": "electron electron/main.js",
    "desktop:build": "npm run desktop:prepare && npm run desktop:tools && npm run desktop:fixcache && electron-builder --win --x64",
    "desktop:tools": "npm install --no-save --no-audit --no-fund electron@^33.2.0 electron-builder@^25.1.8",
    "desktop:fixcache": "node scripts/fix-builder-cache.mjs"
  },
  "dependencies": {
    "next": "16.3.2",
    "node-sqlite3-wasm": "^0.8.60",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9"
  },
  "author": {
    "name": "주식회사 리미트"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "kr.co.limit.orakfood.reelsstudio",
    "productName": "오락푸드 AI릴스 자동제작 스튜디오",
    "copyright": "Copyright © 주식회사 리미트",
    "directories": {
      "output": "dist-installer",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "dist-app",
        "to": "app"
      },
      {
        "from": "dist-bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "오락푸드-AI릴스-자동제작-스튜디오-Setup-x64.${ext}",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "오락푸드 AI릴스 자동제작 스튜디오",
      "installerLanguages": [
        "ko-KR"
      ],
      "language": "1042",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
