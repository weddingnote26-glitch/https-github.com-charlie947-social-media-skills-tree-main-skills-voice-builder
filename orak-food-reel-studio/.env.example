# ===== 오락푸드 AI 릴스 스튜디오 환경설정 =====
# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤 값을 채워 주세요.
# 값이 없는 항목은 프로그램 안에서 "API 연결 필요" 로 표시되며,
# Sample Mode 로는 API 키 없이도 전체 흐름을 시험할 수 있습니다.

# --- Claude (대본·캡션·기획 생성) ---
ANTHROPIC_API_KEY=
# 기본은 가장 똑똑한 모델입니다. 비용을 아끼려면 claude-sonnet-5 로 바꾸세요
# (대본 1편 비용은 어느 쪽이든 100원 안팎이라 큰 차이는 없습니다)
ANTHROPIC_MODEL=claude-opus-5

# --- ElevenLabs (AI 음성) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- 이미지 생성 (gemini | openai | sample) ---
IMAGE_PROVIDER=sample
IMAGE_API_KEY=
IMAGE_MODEL=

# --- Instagram (Meta 공식 API) ---
# Professional 계정 + Facebook 앱에서 발급. 설정 화면의 안내를 따라 주세요.
# Cloudflare Workers AI — 무료 사용량으로 이미지 생성 (dash.cloudflare.com → Workers AI)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_CHARACTER_MODEL=@cf/bytedance/stable-diffusion-xl-lightning

# --- 영상 생성 AI (선택) — 클링 AI 등 ---
# 지금은 키와 모델 이름만 보관합니다. 모델 이름은 서비스가 알려 준 값을 그대로 넣으세요.
KLING_API_KEY=
KLING_MODEL=

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# 완성된 영상을 Instagram이 내려받을 수 있는 공개 HTTPS 주소의 기본 URL
# 예: https://media.example.com  (뒤에 /output/... 이 붙습니다)
PUBLIC_MEDIA_BASE_URL=

# --- 프로그램 ---
APP_PORT=3000
# sample 로 두면 API 키 없이 샘플 데이터로 전체 제작 흐름을 시험합니다
APP_MODE=sample
